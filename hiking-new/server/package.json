{
  "name": "hiking-china-api",
  "version": "1.0.0",
  "description": "徒步中国 API Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate:dry-run": "node scripts/migrate-local-to-turso.cjs",
    "migrate:check": "node scripts/migrate-local-to-turso.cjs --check",
    "migrate:apply": "node scripts/migrate-local-to-turso.cjs --apply",
    "migrate:merge:check": "node scripts/migrate-local-to-turso.cjs --merge-content --check",
    "migrate:merge:apply": "node scripts/migrate-local-to-turso.cjs --merge-content --apply",
    "admin:grant": "node scripts/set-admin.cjs",
    "backup:turso": "node scripts/backup-turso.cjs",
    "accounts:process-deletions": "node scripts/process-account-deletions.cjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@sentry/node": "^10.76.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "sanitize-html": "^2.18.1"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
